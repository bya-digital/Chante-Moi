# =============================================================
# MeloKado — variables d'environnement
# Copier en .env.local et remplir. Ne jamais commiter de vraies clés.
# =============================================================

# --- Supabase (DB + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Service role — serveur uniquement, jamais exposé au client
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3004
NEXT_PUBLIC_DEFAULT_CURRENCY=XOF
NEXT_PUBLIC_DEFAULT_COUNTRY=CI

# --- IA texte (paroles, compréhension d'histoire) ---
# OpenAI = provider principal, Anthropic = fallback (voir src/services/ai)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Speech-to-text (mode vocal) ---
# Voir src/services/speech — au moins 2 providers, jamais un seul point de défaillance
OPENAI_API_KEY_SPEECH=
DEEPGRAM_API_KEY=

# --- Génération musicale ---
# Aucun provider "musique à partir de paroles" n'est câblé en dur : voir
# src/services/music/README.md pour le statut réel de chaque intégration candidate.
SUNO_API_KEY=
MUSIC_PROVIDER_FALLBACK_API_KEY=

# --- Paiement (agrégateurs Afrique + internationaux) ---
# Un provider s'active dès que sa clé est renseignée (voir src/services/payment/registry.ts)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
IKEPAY_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Stockage média (fallback si Supabase Storage ne suffit pas) ---
CLOUDINARY_URL=

# --- Notifications ---
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=

# --- Monitoring ---
SENTRY_DSN=

# --- Sécurité webhooks / jobs internes ---
GENERATION_WEBHOOK_SECRET=
